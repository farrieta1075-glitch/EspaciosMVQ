generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String  @id @db.VarChar(64)
  email                 String? @db.VarChar(320)
  username              String? @db.VarChar(128)
  passwordHash          String? @db.VarChar(256)
  role                  String  @db.VarChar(32)
  areaId                String? @db.VarChar(64)
  active                Boolean @default(true)
  receiveApprovalEmails Boolean @default(true)
  canViewAllSpaces      Boolean @default(false)
  areaScopeIds          String  @default("[]") @db.Text

  @@map("Users")
}

model Area {
  id           String  @id @db.VarChar(64)
  name         String  @db.VarChar(256)
  code         String  @default("") @db.VarChar(64)
  parentId     String? @db.VarChar(64)
  colorHex     String  @default("") @db.VarChar(16)
  eventPresets String  @default("[]") @db.Text

  @@map("Areas")
}

model FloorMap {
  id                      String @id @db.VarChar(64)
  name                    String @db.VarChar(256)
  backgroundType          String @default("blank") @db.VarChar(32)
  backgroundUrl           String @default("") @db.VarChar(2048)
  width                   Int    @default(0)
  height                  Int    @default(0)
  secondaryBackgroundType String @default("") @db.VarChar(32)
  secondaryBackgroundUrl  String @default("") @db.VarChar(2048)
  secondaryWidth          Int    @default(0)
  secondaryHeight         Int    @default(0)
  primaryFloor            String @default("1") @db.VarChar(8)
  floor1Label             String @default("Planta baja") @db.VarChar(128)
  floor2Label             String @default("Piso 2") @db.VarChar(128)

  @@map("Maps")
}

model Space {
  id           String  @id @db.VarChar(64)
  name         String  @db.VarChar(256)
  floor        String  @default("") @db.VarChar(64)
  capacity     Int     @default(0)
  geometryJson String  @default("{}") @db.Text
  mapId        String  @db.VarChar(64)
  active       Boolean @default(true)
  minCapacity  Int     @default(0)
  isCommon     Boolean @default(true)

  @@index([mapId])
  @@map("Spaces")
}

model Resource {
  id                  String  @id @db.VarChar(64)
  name                String  @db.VarChar(256)
  type                String  @default("") @db.VarChar(64)
  totalQty            Int     @default(0)
  imageUrl            String  @default("") @db.VarChar(2048)
  scope               String  @default("") @db.VarChar(64)
  active              Boolean @default(true)
  scalesWithAttendees Boolean @default(false)

  @@map("Resources")
}

model ResourceSpace {
  resourceId String @db.VarChar(64)
  spaceId    String @db.VarChar(64)

  @@id([resourceId, spaceId])
  @@map("ResourceSpaces")
}

model Reservation {
  id                        String  @id @db.VarChar(64)
  eventName                 String  @db.VarChar(512)
  spaceIds                  String  @default("[]") @db.Text
  areaId                    String  @db.VarChar(64)
  userId                    String  @db.VarChar(64)
  startAt                   String  @db.VarChar(64)
  endAt                     String  @db.VarChar(64)
  recurrenceRule            String  @default("") @db.Text
  status                    String  @db.VarChar(32)
  eventDescription          String  @default("") @db.Text
  pendingAction             String  @default("") @db.VarChar(32)
  pendingPayload            String  @default("") @db.Text
  approvalToken             String  @default("") @db.VarChar(128)
  approvalBatchId           String  @default("") @db.VarChar(64)
  estimatedAttendees        Int     @default(0)
  attendeeJustificationCode String  @default("") @db.VarChar(64)
  attendeeJustificationNote String  @default("") @db.Text
  actualAttendees           Int?
  attendanceComment         String  @default("") @db.Text
  sendEventReminder         Boolean @default(false)

  @@index([areaId])
  @@index([userId])
  @@index([status])
  @@index([approvalBatchId])
  @@map("Reservations")
}

model ReservationResource {
  reservationId String @db.VarChar(64)
  resourceId    String @db.VarChar(64)
  quantity      Int    @default(1)

  @@id([reservationId, resourceId])
  @@map("ReservationResources")
}

model EventHistory {
  eventName  String @db.VarChar(512)
  areaId     String @db.VarChar(64)
  count      Int    @default(0)
  lastUsedAt String @default("") @db.VarChar(64)

  @@id([eventName, areaId])
  @@map("EventHistory")
}

model Notification {
  id            String   @id @db.VarChar(64)
  userId        String   @db.VarChar(64)
  areaId        String   @default("") @db.VarChar(64)
  reservationId String   @default("") @db.VarChar(64)
  type          String   @db.VarChar(64)
  message       String   @db.Text
  read          Boolean  @default(false)
  createdAt     DateTime

  @@index([userId, createdAt])
  @@index([reservationId, type])
  @@map("Notifications")
}

model PushSubscription {
  id        String   @id @db.VarChar(64)
  userId    String   @db.VarChar(64)
  deviceId  String   @db.VarChar(128)
  endpoint  String   @unique @db.VarChar(2048)
  p256dh    String   @db.VarChar(512)
  auth      String   @db.VarChar(256)
  userAgent String   @default("") @db.VarChar(512)
  updatedAt DateTime

  @@index([userId])
  @@index([deviceId])
  @@map("PushSubscriptions")
}

model UserActivityLog {
  id        String   @id @db.VarChar(64)
  userId    String   @db.VarChar(64)
  userLabel String   @default("") @db.VarChar(256)
  areaId    String   @default("") @db.VarChar(64)
  action    String   @db.VarChar(64)
  summary   String   @default("") @db.VarChar(512)
  path      String   @default("") @db.VarChar(512)
  meta      String   @default("") @db.Text
  createdAt DateTime

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("UserActivityLogs")
}
