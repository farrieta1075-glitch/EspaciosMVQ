# Vercel Blob (mapas y fotos de recursos en producción)
# En Vercel: Project → Storage → Blob → Connect (inyecta BLOB_STORE_ID y token).
# En local: copia BLOB_READ_WRITE_TOKEN del mismo store para migrate:uploads-to-blob
BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID lo asigna Vercel al conectar el store (no hace falta en .env.local)
# private (por defecto) o public si tu store en Vercel es público
BLOB_ACCESS=private

# Google Sheets
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Auth.js / NextAuth
AUTH_SECRET=
# URL pública con https, sin barra final. En Dokploy/VPS es obligatoria (no dejar localhost).
# APP_URL=   # opcional; si AUTH_URL en producción sigue siendo localhost, usa APP_URL para correos.
AUTH_URL=http://localhost:3000

# --- Correo (Gmail / Google Workspace) ---
# 1) Activa verificación en 2 pasos en la cuenta Google.
# 2) Crea contraseña de aplicación: https://myaccount.google.com/apppasswords
# 3) Recomendado (evita errores al parsear EMAIL_SERVER con @ en el correo):

EMAIL_SMTP_USER=tu@tudominio.com
EMAIL_SMTP_PASSWORD=contraseña_de_aplicacion_sin_espacios
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_FORCE_IPV4=true
EMAIL_FROM="MVQro Espacios <tu@tudominio.com>"

# Alternativa en una sola línea (codifica el @ del correo como %40 si hace falta):
# EMAIL_SERVER=smtp://tu%40tudominio.com:CONTRASEÑA@smtp.gmail.com:587

# Depuración en consola del servidor (messageId de cada envío):
# EMAIL_DEBUG=true

# Correos extra para avisos de reserva (opcional, separados por coma)
# EMAIL_NOTIFY_ADMINS=otro@tudominio.com

# WhatsApp (enlaces wa.me en el correo, sin API)
# WHATSAPP_NOTIFY_PHONES=5214421234567
WHATSAPP_NOTIFY_PHONES=

# Web Push (notificaciones del sistema en el celular)
# Genera claves: npm run generate:vapid
# En Dokploy: las tres variables; NEXT_PUBLIC_* exige Rebuild (no solo Reload).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Obligatorio para iPhone (o deja vacío si EMAIL_SMTP_USER / AUTH_URL ya son reales):
WEB_PUSH_VAPID_SUBJECT=mailto:soporte@tudominio.com

# Google Sheets: pestaña PushSubscriptions (fila 1):
# id, userId, deviceId, endpoint, p256dh, auth, userAgent, updatedAt

# PostgreSQL (Prisma) — Dokploy / VPS. Catálogo + reservas + notificaciones + push.
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_bd?schema=public
# Alias aceptado por la app:
# POSTGRES_URL=postgresql://...
DATABASE_URL=

# Migración Azure SQL → Postgres (npm run db:migrate-from-azure):
# AZURE_SQL_SERVER=mvqro-sql.database.windows.net
# AZURE_SQL_DATABASE=mvqroeventos-sql-db
# AZURE_SQL_USER=
# AZURE_SQL_PASSWORD=
# Origen alternativo: SOURCE_DATABASE_URL=sqlserver://host:1433;database=...;user=...;password=...
